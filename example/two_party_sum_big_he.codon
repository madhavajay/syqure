from numpy.create import array

import sequre.lattiseq.ckks as ckks

from sequre import mpc
from sequre.types.ciphertensor import Ciphertensor


def load_json(path: str) -> List[int]:
    content = open(path).read().strip()
    if not content or content == "[]":
        return []
    inner = content.strip("[]").strip()
    if not inner:
        return []
    result: List[int] = []
    for x in inner.split(","):
        x = x.strip()
        if x:
            result.append(int(x))
    return result


def save_json(path: str, data: List[int]):
    parts: List[str] = []
    for x in data:
        parts.append(str(x))
    open(path, "w").write("[" + ",".join(parts) + "]")


def main():
    m = mpc()
    pid = m.pid

    input_path = "example/aligned_counts.json"

    all_data = load_json(input_path)
    n = len(all_data)
    data: List[int] = all_data if (pid == 1 or pid == 2) else []
    print(f"CP{pid}: n={n}, data_len={len(data)}")

    m.comms.sync_parties()
    print(f"CP{pid}: starting HE aggregation with n={n}")

    if pid > 0:
        float_data: List[float] = []
        if len(data) > 0:
            for x in data:
                float_data.append(float(x))
        else:
            for _ in range(n):
                float_data.append(0.0)

        local_ct = Ciphertensor[ckks.Ciphertext].enc(m, array(float_data))

        if pid == 1:
            other_ct = m.comms.receive_as_jar(2, Ciphertensor[ckks.Ciphertext])
            total = local_ct.add(m, other_ct)
            m.comms.send_as_jar(total, 2)
        else:
            m.comms.send_as_jar(local_ct, 1)
            total = m.comms.receive_as_jar(1, Ciphertensor[ckks.Ciphertext])

        revealed = total.reveal(m, T=float).flatten().tolist()
        result: List[int] = []
        for x in revealed:
            result.append(int(round(x)))

        print(f"CP{pid}: result length={len(result)}, first 5={result[:5]}, last 5={result[-5:]}")

        output_path = f"/tmp/syqure_big_he_result_cp{pid}.json"
        save_json(output_path, result)
        print(f"CP{pid}: saved to {output_path}")

    m.done()


main()
